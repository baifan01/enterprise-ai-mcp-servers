# 复制为 .env.local 或 .env 后填写真实值。本目录 .gitignore 会忽略这两个文件，不要提交。

# CPMS API gateway base URL
DRIIVZ_BASE_URL=https://apex-migration.driivz.com:8103/api-gateway

# 认证方式三选一即可。

# 方式 1：直接使用浏览器登录后的 Cookie，适合快速试 REST。
# DRIIVZ_COOKIE=JSESSIONID=<redacted>; DriivzNewOpRememberMe=<redacted>; HIDE_OP_HF=true

# 方式 2：使用已拿到的 DMS ticket。
# DRIIVZ_DMS_TICKET=<redacted>

# 方式 3：让脚本调用 /v1/authentication/operator/login 获取 ticket。
# DRIIVZ_USERNAME=<your username>
# 如果密码里有 #、空格、$、引号等特殊字符，建议用引号包起来。
# DRIIVZ_PASSWORD="<your password>"

# HTTP 超时时间，单位秒。
DRIIVZ_TIMEOUT_SECONDS=30
