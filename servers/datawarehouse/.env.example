DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=

DATABRICKS_CATALOG=emobility-uc-prd
DATABRICKS_SCHEMA=curated-emob-ubitricity-core

# Optional query behavior
DATABRICKS_ATTEMPT_SEARCH_WINDOW_MINUTES=30
DATABRICKS_OCPP_TIME_BUFFER_SECONDS=3
